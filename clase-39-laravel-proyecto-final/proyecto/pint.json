{
    "preset": "laravel",
    "exclude": [
        "bootstrap",
        "config",
        "public"
    ],
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "php_unit_method_casing": {
            "case": "camel_case"
        },
        "new_with_parentheses": {
            "named_class": true,
            "anonymous_class": false
        }
    }
}
